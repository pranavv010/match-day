# Live Scores - Environment Variables
# Copy this file to .env and fill in your API keys
# NEVER commit .env to version control

# API-Sports Football API keys (get from https://www.api-football.com/)
API_KEY_PRIMARY=your_primary_api_key_here
API_KEY_BACKUP_1=your_backup_1_api_key_here
API_KEY_BACKUP_2=your_backup_2_api_key_here

# Google Gemini AI key (optional - app works without it using fallback content)
GEMINI_API_KEY=your_gemini_api_key_here
